Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dxMat", "=", 
     RowBox[{"Get", "[", "\"\<numerical_evaluation/input/dx.m\>\"", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dxAtY0", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"dxMat", "/.", " ", 
        RowBox[{"y", "->", "y0"}]}], "/.", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r1", "->", 
          RowBox[{"sqrt", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], "/", "y0"}]}]}], ",", 
         RowBox[{"r2", "->", 
          RowBox[{"sqrt", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "y0"}], ")"}], "/", "y0"}]}]}]}], "}"}]}], "/.",
