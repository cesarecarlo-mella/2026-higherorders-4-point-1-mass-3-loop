    FractionBox[
     RowBox[{"2", " ", "\[ImaginaryI]", " ", 
      SqrtBox["x"], " ", "y"}], 
     SqrtBox[
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "y"}], ")"}], " ", "y"}], ")"}]}]]], "+", 
    
    RowBox[{"x", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["y", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "y"}]]}], "+", 
       FractionBox[
        SqrtBox[
         RowBox[{"-", 
          FractionBox["y", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "y"}]]}]], 
        RowBox[{"2", " ", 
