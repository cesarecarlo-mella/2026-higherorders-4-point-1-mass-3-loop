Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"JD", "=", " ", 
    RowBox[{"Import", "[", "\"\<./matrix_to_JD/toJD/JD7.m\>\"", "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"eigenvalues", "=", " ", 
    RowBox[{
    "Import", "[", "\"\<./matrix_to_JD/toJD/eigenvalues7.m\>\"", "]"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Expon", "[", "7", "]"}], " ", "=", " ", 
    RowBox[{"Import", "[", "\"\<./matrix_to_JD/toJD/expon7.m\>\"", "]"}]}], ";",
    "\[IndentingNewLine]", 
   RowBox[{"totake", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Cases", "[", 
             RowBox[{"eigenvalues", ",", " ", 
              RowBox[{
               RowBox[{"Power", "[", 
                RowBox[{"delta", ",", 
                 RowBox[{"a_", " ", "eps"}]}], "]"}], " ", "/;", " ", 
               RowBox[{"a", ">", "0"}]}], ",", " ", "Infinity"}], "]"}], ",", 
            " ", 
            RowBox[{"Cases", "[", 
             RowBox[{"eigenvalues", ",", " ", 
              RowBox[{"Power", "[", 
               RowBox[{"delta", ",", " ", "eps"}], "]"}], " ", ",", " ", 
              "Infinity"}], "]"}]}], "]"}], "//", "Union"}], ")"}], " ", "/.",
         " ", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{"delta", ",", "t_"}], "]"}], "->", " ", "t"}]}], " ", "/.", 
       " ", 
       RowBox[{"eps", "->", " ", "1"}]}], ")"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"matr", "[", "i", "]"}], "=", 
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Expon", "[", "7", "]"}], ",", 
           RowBox[{"delta", "^", 
            RowBox[{"(", " ", 
             RowBox[{"i", " ", "eps"}], ")"}]}]}], "]"}], " ", "/.", " ", 
         RowBox[{
          RowBox[{"Log", "[", "delta", "]"}], " ", "->", " ", "0"}]}]}], " ", 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "totake"}], "}"}]}], "]"}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boundaryMxy", "[", "7", "]"}], " ", "=", " ", 
    RowBox[{"matr", "[", 
     RowBox[{"totake", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "totake", "]"}], ">", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"boundaryMxy", "[", "7", "]"}], " ", "=", " ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"boundaryMxy", "[", "7", "]"}], ",", " ", 
             RowBox[{"matr", "[", 
              RowBox[{"totake", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", 
            RowBox[{"Length", "[", "totake", "]"}]}], "}"}]}], "]"}]}], "]"}],
       "\[IndentingNewLine]", 
      RowBox[{"boundaryMxy", "[", "7", "]"}]}], "//", 
