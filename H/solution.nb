Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CoefficientToKira", "[", 
    RowBox[{"VarCoefficient_", ",", "VarWeight_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "KiraFileLine", "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"VarCoefficient", "===", "0"}], ",", 
        RowBox[{"Return", "[", "\"\<\>\"", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"KiraFileLine", "=", 
       RowBox[{
        RowBox[{"ToString", "[", "VarWeight", "]"}], "<>", "\"\<*(\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"VarCoefficient", ",", "InputForm"}], "]"}], 
        "<>", "\"\<)\\n\>\""}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"StringDelete", "[", 
        RowBox[{"KiraFileLine", ",", "\"\< \>\""}], "]"}], "]"}], ";"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CanonicalForKira", "[", "ToTransform_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "KiraWeights", ",", "WeightCoef", ",", "LinearKiraWeightQ", ",", 
      "NoWeightLessTermQ", ",", "KiraRelation"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"KiraWeights", "=", 
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2x12", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2x13", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2x23", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2x123", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], ",", 
        RowBox[{"Cases", "[", 
         RowBox[{"ToTransform", ",", 
          RowBox[{"I2x132", "[", "a___", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"extract", " ", "all", " ", "the", " ", "coefficient"}], "*)"}],
      "\[IndentingNewLine]", 
     RowBox[{"WeightCoef", "=", 
      RowBox[{
       RowBox[{"CoefficientArrays", "[", 
        RowBox[{"ToTransform", ",", "KiraWeights"}], "]"}], "//", 
       "Normal"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Consistency", " ", 
       RowBox[{"check", ":", "\[IndentingNewLine]", 
        RowBox[{"verify", " ", "that", " ", "is", " ", "linear"}]}]}], "   ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"LinearKiraWeightQ", "=", 
      RowBox[{
       RowBox[{"Length", "[", "WeightCoef", "]"}], "===", "2"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Not", "[", "LinearKiraWeightQ", "]"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Error: Equation is not linear. Check input.\>\"", 
         "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"NoWeightLessTermQ", "=", 
      RowBox[{
       RowBox[{"WeightCoef", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "==", "0"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Not", "[", "NoWeightLessTermQ", "]"}], ",", 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<Error: Constant term is not 0. Check input.\>\"", 
         "]"}], ";", " ", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Remove", " ", "0", " ", "coefficients"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"WeightCoef", "=", 
      RowBox[{"WeightCoef", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Convert", " ", "to", " ", "Kira", " ", 
       RowBox[{"string", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"KiraRelation", "=", 
      RowBox[{"StringJoin", "@", 
       RowBox[{"MapThread", "[", 
        RowBox[{"CoefficientToKira", ",", 
         RowBox[{"{", 
          RowBox[{"WeightCoef", ",", "KiraWeights"}], "}"}]}], "]"}]}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "KiraRelation", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 InitializationCell->True,
