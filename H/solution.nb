Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"(*", 
   RowBox[{"solve", " ", "the", " ", "system"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"toinvert", " ", "=", 
    RowBox[{"{", " ", 
     RowBox[{"coeffMat", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "}"}]}], " ", ";", 
   "\[IndentingNewLine]", 
   RowBox[{"i", " ", "=", " ", "3"}], ";", "\[IndentingNewLine]", 
   RowBox[{"Positions", " ", "=", 
