    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JregAtX1", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"maxWeight", "==", "0"}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "Y0", ",", "sol", ",", "Yend", ",", "uStart", ",", "u1", ",", 
           "rStart"}], "}"}], ",", 
         RowBox[{
          RowBox[{"Y0", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Jreg0", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "maxWeight"}], "}"}]}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"useAuxiliaryRootODE", ",", 
            RowBox[{
             RowBox[{"rStart", "=", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"rClosedForm", "[", "xStart", "]"}], ",", "precND"}], 
               "]"}]}], ";", 
             RowBox[{"(*", 
              RowBox[{
              "closed", " ", "form", " ", "used", " ", "only", " ", "to", " ",
                "SEED", " ", "the", " ", "ODE", " ", "at", " ", "xStart"}], 
              "*)"}], 
             RowBox[{"Y0", "=", 
              RowBox[{"Append", "[", 
               RowBox[{"Y0", ",", "rStart"}], "]"}]}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"t0", "=", 
           RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{"useSqrtVariable", ",", 
            RowBox[{
             RowBox[{"uStart", "=", 
              RowBox[{"Sqrt", "[", "xStart", "]"}]}], ";", 
             RowBox[{"u1", "=", 
              RowBox[{"Sqrt", "[", "x1", "]"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Integrating ODE (state dimension \>\"", ",", 
               RowBox[{"Length", "[", "Y0", "]"}], 
               ",", "\"\<) in u=Sqrt[x], from u=\>\"", ",", 
               RowBox[{"N", "[", "uStart", "]"}], ",", "\"\< to u=\>\"", ",", 
               
               RowBox[{"N", "[", "u1", "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                "useAuxiliaryRootODE", 
                 ",", "\"\<  [with auxiliary root ODE, +1 dim]\>\"", 
                 ",", "\"\<\>\""}], "]"}], ",", "\"\< ...\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sol", "=", 
              RowBox[{"NDSolve", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Y", "'"}], "[", "u", "]"}], "==", 
                   RowBox[{"rhsU", "[", 
                    RowBox[{"u", ",", 
                    RowBox[{"Y", "[", "u", "]"}]}], "]"}]}], ",", 
                  RowBox[{
                   RowBox[{"Y", "[", "uStart", "]"}], "==", "Y0"}]}], "}"}], ",",
                 "Y", ",", 
                RowBox[{"{", 
                 RowBox[{"u", ",", "uStart", ",", "u1"}], "}"}], ",", 
                RowBox[{"WorkingPrecision", "->", "workingPrecisionND"}], ",", 
                RowBox[{"PrecisionGoal", "->", "precisionGoalND"}], ",", 
                RowBox[{"MaxSteps", "->", "100000"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Yend", "=", 
              RowBox[{
               RowBox[{"Y", "[", "u1", "]"}], "/.", " ", 
               RowBox[{"First", "[", "sol", "]"}]}]}], ";"}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Integrating ODE (state dimension \>\"", ",", 
               RowBox[{"Length", "[", "Y0", "]"}], ",", "\"\<) from x=\>\"", ",", 
               RowBox[{"N", "[", "xStart", "]"}], ",", "\"\< to x=\>\"", ",", 
               
               RowBox[{"N", "[", "x1", "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                "useAuxiliaryRootODE", 
                 ",", "\"\<  [with auxiliary root ODE, +1 dim]\>\"", 
                 ",", "\"\<\>\""}], "]"}], ",", "\"\< ...\>\""}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sol", "=", 
