   RowBox[{
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"MatrixRank", "[", "toinvert", "]"}], "<", 
         RowBox[{"(", 
          RowBox[{"Length", "[", "vars", "]"}], " ", ")"}]}], "&&", " ", 
        RowBox[{"i", " ", "<=", " ", 
         RowBox[{"Length", "[", "system", "]"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixRank", "[", 
            RowBox[{"Append", "[", 
             RowBox[{"toinvert", ",", " ", 
              RowBox[{"coeffMat", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ">", " ", 
           RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"toinvert", " ", "=", " ", 
            RowBox[{"Append", "[", 
             RowBox[{"toinvert", ",", 
              RowBox[{"coeffMat", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
           RowBox[{"Positions", "=", 
            RowBox[{"Append", "[", 
             RowBox[{"Positions", ",", "i"}], "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"i", ",", " ", "\"\<   rank = \>\"", ",", " ", 
          RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], "]"}], ";", " ", 
        RowBox[{"i", "=", 
         RowBox[{"i", "+", "1"}]}]}]}], "]"}], "\[IndentingNewLine]", 
     RowBox[{"Det", "[", "toinvert", "]"}], "\[IndentingNewLine]", 
