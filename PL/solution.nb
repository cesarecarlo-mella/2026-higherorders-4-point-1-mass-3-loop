        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "z"}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "y", "+", "z"}], "]"}], " ", "->", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "y", "-", "z"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "y"}], "]"}], " ", "->", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"1", "-", "y"}], "]"}]}]}], "}"}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"atilde", " ", "=", " ", 
    RowBox[{"atilde", " ", "-", 
     RowBox[{"(", 
