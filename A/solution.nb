Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"build", " ", "final", " ", "system"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"system", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{
        "eq1", ",", "eq2top5", ",", " ", "eq3top5", ",", " ", "eq4top5", ",", 
         "eq5top5", ",", "eq6top5", ",", "eq7top5"}], "]"}], "/.", " ", 
       RowBox[{
        RowBox[{"plrules", "[", "1", "]"}], "[", "5", "]"}]}], "//", 
      "Union"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"Union", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{"system", ",", " ", 
        RowBox[{
         RowBox[{"cnst", "[", 
          RowBox[{"1", ",", "a_"}], "]"}], "[", "5", "]"}], ",", " ", 
        "Infinity"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coeffMat", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"CoefficientArrays", "[", 
          RowBox[{"system", ",", " ", "vars"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "//", "Normal"}], ")"}], "//", 
      "Union"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"coeffMat", "//", "MatrixRank"}], ")"}], "===", 
    RowBox[{"Length", "[", "vars", "]"}]}]}]}]], "Input",
