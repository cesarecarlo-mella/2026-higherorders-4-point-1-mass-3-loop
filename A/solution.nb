Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"solve", " ", "the", " ", "system"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"toinvert", " ", "=", 
     RowBox[{"{", " ", 
      RowBox[{"coeffMat", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "}"}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Positions", " ", "=", 
     RowBox[{"{", "1", "}"}]}], ";"}], "\n", 
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixRank", "[", "toinvert", "]"}], "<", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "vars", "]"}], " ", ")"}]}], "&&", " ", 
      RowBox[{"i", " ", "<=", " ", 
       RowBox[{"Length", "[", "system", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixRank", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"toinvert", ",", " ", 
            RowBox[{"coeffMat", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ">", " ", 
         RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"toinvert", " ", "=", " ", 
          RowBox[{"Append", "[", 
           RowBox[{"toinvert", ",", 
            RowBox[{"coeffMat", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"Positions", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"Positions", ",", "i"}], "]"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"i", ",", " ", "\"\<   rank = \>\"", ",", " ", 
        RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], "]"}], ";", " ", 
      RowBox[{"i", "=", 
       RowBox[{"i", "+", "1"}]}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Det", "[", "toinvert", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverted", " ", "=", " ", 
     RowBox[{"Inverse", "[", "toinvert", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solvars", " ", "=", " ", 
     RowBox[{"inverted", ".", 
      RowBox[{"(", 
       RowBox[{"-", 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"system", "[", 
           RowBox[{"[", "Positions", "]"}], "]"}], " ", "/.", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"cnst", "[", 
             RowBox[{"a_", ",", "b_"}], "]"}], "[", "5", "]"}], " ", "->", 
           "0"}]}], ")"}]}], " ", ")"}]}]}], ";"}]}]}]], "Input",
