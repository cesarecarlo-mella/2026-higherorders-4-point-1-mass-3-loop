  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"CNSTsol", "[", "weight", "]"}], " ", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"cnst", "[", 
         RowBox[{"weight", ",", "i"}], "]"}], "[", "5", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"Length", "[", "Basis", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"templim", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Extract", "[", 
            RowBox[{"SolutionWithPlanar", ",", "onlyplanar"}], "]"}], ",", 
           "eps", ",", "weight"}], "]"}], "/.", " ", 
         RowBox[{"x", "->", " ", "0"}]}], " ", "/.", " ", "Log00"}], "/.", 
       " ", 
       RowBox[{"y", "->", " ", 
        RowBox[{"1", "-", "t"}]}]}], " ", "/.", "tto1Red"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"todo", "=", 
     RowBox[{"Union", "@", 
      RowBox[{"Cases", "[", 
       RowBox[{"templim", ",", " ", 
        RowBox[{"G", "[", 
         RowBox[{"a__", ",", 
          RowBox[{"1", "-", "t"}]}], "]"}], ",", " ", "Infinity"}], "]"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tto1Red", " ", "=", " ", 
