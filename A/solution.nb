Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"solve", " ", "the", " ", "system"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"toinvert", " ", "=", 
     RowBox[{"{", " ", 
      RowBox[{"coeffMat", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "}"}]}], " ", ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Positions", " ", "=", 
     RowBox[{"{", "2", "}"}]}], ";"}], "\n", 
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"MatrixRank", "[", "toinvert", "]"}], "<", 
       RowBox[{"(", 
        RowBox[{"Length", "[", "vars", "]"}], " ", ")"}]}], "&&", " ", 
      RowBox[{"i", " ", "<=", " ", 
       RowBox[{"Length", "[", "system", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixRank", "[", 
          RowBox[{"Append", "[", 
           RowBox[{"toinvert", ",", " ", 
            RowBox[{"coeffMat", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], ">", " ", 
         RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"toinvert", " ", "=", " ", 
          RowBox[{"Append", "[", 
           RowBox[{"toinvert", ",", 
            RowBox[{"coeffMat", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"Positions", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"Positions", ",", "i"}], "]"}]}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"i", ",", " ", "\"\<   rank = \>\"", ",", " ", 
        RowBox[{"MatrixRank", "[", "toinvert", "]"}]}], "]"}], ";", " ", 
      RowBox[{"i", "=", 
       RowBox[{"i", "+", "1"}]}]}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Det", "[", "toinvert", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"inverted", " ", "=", " ", 
     RowBox[{"Inverse", "[", "toinvert", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"solvars", " ", "=", " ", 
     RowBox[{
      RowBox[{"inverted", ".", 
       RowBox[{"(", 
        RowBox[{"-", 
         RowBox[{"(", " ", 
          RowBox[{
           RowBox[{"system", "[", 
            RowBox[{"[", "Positions", "]"}], "]"}], " ", "/.", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"cnst", "[", 
              RowBox[{"a_", ",", "b_"}], "]"}], "[", "5", "]"}], " ", "->", 
            "0"}]}], ")"}]}], " ", ")"}]}], "//", "Simplify"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.925444884589307*^9, 3.92544489473036*^9}, {
  3.925535299851338*^9, 3.925535301125001*^9}},
 CellLabel->
  "In[1008]:=",ExpressionUUID->"520c861e-a716-422e-8acf-3adb8aac5e36"],

